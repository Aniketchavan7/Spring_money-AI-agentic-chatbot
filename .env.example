# Spring Money AI Financial Agent Configuration

# Search & Retriever Configuration
RETRIEVER=tavily
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxx

# LLM Provider Configuration (openai | ollama | google | azureopenai)
LLM_PROVIDER=ollama
FAST_LLM_MODEL=llama3:8b
SMART_LLM_MODEL=llama3:70b
LLM_BASE_URL=http://localhost:11434

# Embedding Configuration
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# Fallback Cloud Providers (optional)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxx

# Agent Tuning Parameters
TEMPERATURE=0.55
FAST_TOKEN_LIMIT=2000
SMART_TOKEN_LIMIT=4000
SUMMARY_TOKEN_LIMIT=700
MAX_SEARCH_RESULTS_PER_QUERY=5
MAX_ITERATIONS=3
REPORT_FORMAT=APA

# LangSmith Observability (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=lsv2-xxxxxxxxxxxxxxxxxxxx
