  "cards": [
    {
      "dot": "emerald",
      "title": "Primary Request Journey",
      "items": [
        "Web Client UI opens an interactive WebSocket stream to FastAPI on port 8000.",
        "WebSocket Manager dispatches tasks into the multi-agent orchestration pipeline.",
        "ChiefEditorAgent compiles a LangGraph StateGraph connecting planner, researcher, writer, and publisher.",
        "GPT Researcher orchestrates recursive subtopic analysis and aggregates structured financial findings.",
        "Report Publisher generates PDF, DOCX, and Markdown artifacts in the outputs directory."
      ]
    },
    {
      "dot": "cyan",
      "title": "Ingestion & Context Compression",
      "items": [
        "TavilySearch retrieves live real-time financial market intelligence and news.",
        "Document scraper extracts raw page content via BeautifulSoup / newspaper3k.",
        "ContextCompressor applies RecursiveCharacterTextSplitter (1000 char chunks) and EmbeddingsFilter.",
        "Semantic similarity threshold (0.38) filters noise before context assembly.",
        "Memory layer retains vector representations using FAISS / Nomic embeddings / pgvector."
      ]
    },
    {
      "dot": "rose",
      "title": "Trust Boundaries & Dependencies",
      "items": [
        "Public Boundary: Untrusted client browser communicates across WebSocket ingress.",
        "Application Container: FastAPI, stream handlers, and exporters run within the Docker boundary.",
        "Agent Core: Multi-agent execution and vector operations are isolated in private runtime state.",
        "External Services: Tavily Search API and Ollama/OpenAI endpoints require authenticated external API calls."
      ]
    }
  ]
